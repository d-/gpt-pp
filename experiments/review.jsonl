# Runs added after an independent review of the experiments (14 November 2026): the comparisons it found unfair, run again.
# opt-adamw-own-*: AdamW on the hidden matrices under its own warmup (8M tokens) and clipping (norm 1), everything else the 2026 recipe.
# split-rung7-*: the ladder's step from rung 6 to rung 7 split in two: the 2026 training recipe on the rung-6 model with AdamW in place of Muon.
# warm-2019-small-*: norm placement and warmup in the 2019 recipe at steps of 8,192 tokens and rate 6e-4 (a warmup of 8M tokens is then 977 steps, not 122).
# swap-pos-sinusoidal-after-norm: sinusoidal positions added after the embedding norm (pos_after_norm); before it they fade as the token rows grow.
{"name": "opt-adamw-own-lr1.2e-3", "cmd": "$PY -m gptpp.train --run opt-adamw-own-lr1.2e-3 --preset gptpp-ladder --tokens 50e6 --eval-tokens 10e6 --set optimizer=adamw+adamw lr=1.2e-3 weight_decay=0.1 beta1=0.9 warmup_tokens=8e6 grad_clip=1.0"}
{"name": "opt-adamw-own-lr2.4e-3", "cmd": "$PY -m gptpp.train --run opt-adamw-own-lr2.4e-3 --preset gptpp-ladder --tokens 50e6 --eval-tokens 10e6 --set optimizer=adamw+adamw lr=2.4e-3 weight_decay=0.1 beta1=0.9 warmup_tokens=8e6 grad_clip=1.0"}
{"name": "split-rung7-adamw-lr1.2e-3", "cmd": "$PY -m gptpp.train --run split-rung7-adamw-lr1.2e-3 --preset gpt2-2019-ladder --train-preset gptpp-ladder --set bias=false pos=rope norm=rmsnorm_fixed act=relu2 qk_norm=true init=zero_proj optimizer=adamw+adamw lr=1.2e-3 weight_decay=0.1 beta1=0.9 warmup_tokens=8e6 grad_clip=1.0 --tokens 100e6 --seed 0 --eval-tokens 10e6"}
{"name": "split-rung7-adamw-lr2.4e-3", "cmd": "$PY -m gptpp.train --run split-rung7-adamw-lr2.4e-3 --preset gpt2-2019-ladder --train-preset gptpp-ladder --set bias=false pos=rope norm=rmsnorm_fixed act=relu2 qk_norm=true init=zero_proj optimizer=adamw+adamw lr=2.4e-3 weight_decay=0.1 beta1=0.9 warmup_tokens=8e6 grad_clip=1.0 --tokens 100e6 --seed 0 --eval-tokens 10e6"}
{"name": "warm-2019-small-post", "cmd": "$PY -m gptpp.train --run warm-2019-small-post --preset gpt2-2019-ladder --tokens 50e6 --eval-tokens 10e6 --set lr=6e-4 device_batch=16 norm_placement=post"}
{"name": "warm-2019-small-post-none", "cmd": "$PY -m gptpp.train --run warm-2019-small-post-none --preset gpt2-2019-ladder --tokens 50e6 --eval-tokens 10e6 --set lr=6e-4 device_batch=16 norm_placement=post warmup_tokens=0"}
{"name": "swap-pos-sinusoidal-after-norm", "cmd": "$PY -m gptpp.train --run swap-pos-sinusoidal-after-norm --preset gptpp-ladder --tokens 50e6 --eval-tokens 10e6 --set pos=sinusoidal pos_after_norm=true"}
{"name": "opt-adamw-own-lr4.8e-3", "cmd": "$PY -m gptpp.train --run opt-adamw-own-lr4.8e-3 --preset gptpp-ladder --tokens 50e6 --eval-tokens 10e6 --set optimizer=adamw+adamw lr=4.8e-3 weight_decay=0.1 beta1=0.9 warmup_tokens=8e6 grad_clip=1.0"}
{"name": "warm-2019-small-pre", "cmd": "$PY -m gptpp.train --run warm-2019-small-pre --preset gpt2-2019-ladder --tokens 50e6 --eval-tokens 10e6 --set lr=6e-4 device_batch=16"}
{"name": "warm-2019-small-pre-none", "cmd": "$PY -m gptpp.train --run warm-2019-small-pre-none --preset gpt2-2019-ladder --tokens 50e6 --eval-tokens 10e6 --set lr=6e-4 device_batch=16 warmup_tokens=0"}
{"name": "opt-adamw-own-lr6e-4", "cmd": "$PY -m gptpp.train --run opt-adamw-own-lr6e-4 --preset gptpp-ladder --tokens 50e6 --eval-tokens 10e6 --set optimizer=adamw+adamw lr=6e-4 weight_decay=0.1 beta1=0.9 warmup_tokens=8e6 grad_clip=1.0"}
